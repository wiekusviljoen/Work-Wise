@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using LeaveWise.Data
@using LeaveWise.Domain
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory

@if (canUseEmployerWorkspace)
{
    <div class="nav-item"><NavLink class="nav-link" href="workspace">Employer workspace</NavLink></div>
    <div class="nav-item"><NavLink class="nav-link" href="team">Team overview</NavLink></div>
}
@if (isOwner)
{
    <div class="nav-item"><NavLink class="nav-link" href="approvals">Leave approvals</NavLink></div>
    <div class="nav-item"><NavLink class="nav-link" href="policies">Policies &amp; balances</NavLink></div>
}

@code {
    private bool canUseEmployerWorkspace;
    private bool isOwner;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var id = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var access = await AccountAccessService.GetAsync(db, id);
        canUseEmployerWorkspace = access.CanUseEmployerWorkspace;
        isOwner = access.IsOwner;
    }
}
