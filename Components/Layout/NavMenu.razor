@implements IDisposable
@inject NavigationManager NavigationManager
<div class="brand-block"><a class="brand-lockup" href=""><img class="brand-mark" src="/work-wise-logo.png" alt="Work-Wise logo" /><span>Work-Wise<small>EMPLOYMENT, MADE CLEARER</small></span></a></div><div class="nav-caption">WORKSPACE</div><button class="mobile-menu-toggle" type="button" @onclick="ToggleMenu" aria-expanded="@menuOpen" aria-controls="workwise-navigation"><span>Menu</span><span class="mobile-menu-chevron @(menuOpen ? "is-open" : "")" aria-hidden="true"></span></button>
<nav id="workwise-navigation" class="nav flex-column app-nav @(menuOpen ? "mobile-nav-open" : "")"><div class="nav-item"><NavLink class="nav-link" href="" Match="NavLinkMatch.All">Overview</NavLink></div><div class="nav-item"><NavLink class="nav-link" href="leave">Leave & absences</NavLink></div><div class="nav-item"><NavLink class="nav-link" href="contracts">My contract</NavLink></div><div class="nav-item"><NavLink class="nav-link" href="benefits">Pay & benefits</NavLink></div><div class="nav-item"><NavLink class="nav-link" href="team">Team</NavLink></div><div class="nav-item"><NavLink class="nav-link" href="workspace">Employer workspace</NavLink></div><div class="nav-item"><NavLink class="nav-link" href="approvals">Leave approvals</NavLink></div><div class="nav-item"><NavLink class="nav-link" href="rules">Leave rules & sources</NavLink></div><div class="nav-item"><NavLink class="nav-link" href="policies">Policies & balances</NavLink></div></nav>
<div class="sidebar-bottom"><div class="sidebar-help"><div class="help-bubble">?</div><div><strong>Need a hand?</strong><small>We're building this together.</small></div></div><AuthorizeView><Authorized><div class="account-row"><span class="avatar-circle">WW</span><div class="account-text"><strong>@context.User.Identity?.Name</strong><small>Signed in</small></div></div><form action="Account/Logout" method="post" class="logout-form"><AntiforgeryToken /><input type="hidden" name="ReturnUrl" value="@currentUrl" /><button type="submit">Sign out</button></form></Authorized><NotAuthorized><a class="sidebar-signin" href="Account/Login">Sign in to your workspace</a><a class="sidebar-signup" href="Account/Register">Create an account</a></NotAuthorized></AuthorizeView></div>
@code { private bool menuOpen; private void ToggleMenu() => menuOpen = !menuOpen; private string? currentUrl; protected override void OnInitialized() { currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri); NavigationManager.LocationChanged += OnLocationChanged; } private void OnLocationChanged(object? sender, LocationChangedEventArgs e) { currentUrl = NavigationManager.ToBaseRelativePath(e.Location); menuOpen = false; StateHasChanged(); } public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged; }
