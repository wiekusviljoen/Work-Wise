@implements IDisposable
@inject NavigationManager NavigationManager
<div class="mobile-nav-container"><input id="workwise-menu-toggle" class="mobile-menu-checkbox" type="checkbox" @bind="menuOpen" aria-label="Toggle navigation" /><div class="mobile-brand-row"><div class="brand-block"><a class="brand-lockup" href=""><img class="brand-mark" src="/work-wise-logo.png" alt="Work-Wise logo" /><span>Work-Wise<small>EMPLOYMENT, MADE CLEARER</small></span></a></div><label class="mobile-menu-toggle" for="workwise-menu-toggle" aria-label="Open navigation menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg><span class="mobile-menu-chevron" aria-hidden="true"></span></label></div><div class="nav-caption">WORKSPACE</div>
<nav id="workwise-navigation" class="nav flex-column app-nav"><div class="nav-item"><NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu">Overview</NavLink></div><div class="nav-item"><NavLink class="nav-link" href="leave" @onclick="CloseMenu">Leave & absences</NavLink></div><div class="nav-item"><NavLink class="nav-link" href="contracts" @onclick="CloseMenu">My contract</NavLink></div><div class="nav-item"><NavLink class="nav-link" href="benefits" @onclick="CloseMenu">Pay & benefits</NavLink></div><EmployerLinks /><div class="nav-item"><NavLink class="nav-link" href="rules" @onclick="CloseMenu">Leave rules & sources</NavLink></div></nav></div>
<div class="sidebar-bottom"><div class="sidebar-help"><div class="help-bubble">?</div><div><strong>Need a hand?</strong><small>We're building this together.</small></div></div><AuthorizeView><Authorized><div class="account-row"><span class="avatar-circle">WW</span><div class="account-text"><strong>@context.User.Identity?.Name</strong><small><AccountKindLabel /></small></div></div><form action="Account/Logout" method="post" class="logout-form"><AntiforgeryToken /><input type="hidden" name="ReturnUrl" value="@currentUrl" /><button type="submit">Sign out</button></form></Authorized><NotAuthorized><a class="sidebar-signin" href="Account/Login">Sign in to your workspace</a><a class="sidebar-signup" href="Account/Register">Create an account</a></NotAuthorized></AuthorizeView></div>
@code { private bool menuOpen; private void CloseMenu() => menuOpen = false; private string? currentUrl; protected override void OnInitialized() { currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri); NavigationManager.LocationChanged += OnLocationChanged; } private void OnLocationChanged(object? sender, LocationChangedEventArgs e) { _ = InvokeAsync(() => { currentUrl = NavigationManager.ToBaseRelativePath(e.Location); menuOpen = false; StateHasChanged(); }); } public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged; }
