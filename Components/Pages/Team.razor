@page "/team"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "EmployerAccount")]
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using LeaveWise.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory
<PageTitle>Team | Work-Wise</PageTitle>
<div class="page-wrap">
    <div class="page-title-row"><div><p class="eyebrow">YOUR WORKSPACES</p><h1>Team overview</h1><p class="page-intro">Current employee and leave counts across the companies you own.</p></div></div>
    @if (loading) { <section class="panel">Loading your team…</section> }
    else
    {
        <section class="panel"><div class="team-stats">
            <div><span>Active employees</span><strong>@employeeCount</strong><small>Archived records are excluded</small></div>
            <div><span>Requests to review</span><strong>@pendingCount</strong><small>Pending employer decisions</small></div>
            <div><span>Current & upcoming absences</span><strong>@upcomingCount</strong><small>Approved requests ending today or later</small></div>
        </div></section>
        <section class="panel"><h2>Manage your team</h2><p>Add, edit or remove employee records in your employer workspace.</p><div class="employee-actions"><a class="button-primary" href="workspace">Manage employees</a><a class="button-secondary" href="approvals">Review leave</a></div></section>
    }
</div>
@code {
    private bool loading = true;
    private int employeeCount, pendingCount, upcomingCount;
    protected override async Task OnInitializedAsync()
    {
        var actor = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier);
        await using var db = await DbFactory.CreateDbContextAsync();
        var orgs = db.OrganizationMemberships.Where(x => x.UserId == actor && x.IsActive && x.Role == "Owner").Select(x => x.OrganizationId);
        employeeCount = await db.EmploymentRecords.CountAsync(x => orgs.Contains(x.OrganizationId) && x.Status == "Active");
        pendingCount = await db.LeaveRequests.CountAsync(x => orgs.Contains(x.EmploymentRecord.OrganizationId) && x.Status == "Pending");
        var today = DateOnly.FromDateTime(DateTime.Today);
        upcomingCount = await db.LeaveRequests.CountAsync(x => orgs.Contains(x.EmploymentRecord.OrganizationId) && x.Status == "Approved" && x.EndDate >= today);
        loading = false;
    }
}
