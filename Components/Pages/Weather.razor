@page "/weather"

<PageTitle>Weather integration | Work-Wise</PageTitle>

<div class="page-wrap">
    <div class="page-title-row">
        <div>
            <p class="eyebrow">INTEGRATION STATUS</p>
            <h1>Weather integration</h1>
            <p class="page-intro">Weather data is not part of the current Work-Wise release.</p>
        </div>
        <span class="demo-badge">NOT CONNECTED</span>
