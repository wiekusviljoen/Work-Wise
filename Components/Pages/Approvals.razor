@page "/approvals"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "EmployerOnly")]
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using LeaveWise.Data
@using LeaveWise.Domain
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Leave approvals | Work-Wise</PageTitle>
<div class="page-wrap">
    <div class="page-title-row">
        <div><p class="eyebrow">EMPLOYER WORKFLOW</p><h1>Leave approvals</h1><p class="page-intro">Review submitted leave requests for the organizations you own.</p></div>
        <span class="demo-badge">EARLY ACCESS</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(feedback))
    {
        <div class="notice-banner"><span class="notice-symbol">i</span><div><strong>@feedback</strong><p>@feedbackDetail</p></div></div>
    }
    @if (isLoading)
    {
        <section class="panel"><p>Loading requests…</p></section>
    }
    else if (ownedOrganizationIds.Count == 0)
    {
        <section class="panel empty-state"><span class="empty-icon">INFO</span><strong>No employer workspace access</strong><p>Create a workspace or ask its owner to grant you an appropriate role. Only workspace owners can review requests in this early-access version.</p></section>
    }
    else if (requests.Count == 0)
    {
        <section class="panel empty-state"><span class="empty-icon">INFO</span><strong>You're all caught up</strong><p>There are no pending leave requests in your workspaces.</p></section>
    }
    else
    {
        <section class="panel">
            <div class="panel-heading"><div><p class="eyebrow">AWAITING YOUR DECISION</p><h2>Pending requests</h2></div><span class="count-chip">@requests.Count</span></div>
            @foreach (var item in requests)
            {
                <div class="approval-item">
                    <div class="approval-main">
                        <div class="request-date">@item.StartDate.ToString("dd")<small>@item.StartDate.ToString("MMM")</small></div>
                        <div class="request-detail">
                            <strong>@item.EmployeeName - @item.LeaveType</strong>
                            <small>@item.OrganizationName</small>
                            <small>@item.StartDate.ToString("dd MMM yyyy") - @item.EndDate.ToString("dd MMM yyyy") · @item.ScheduledWorkdays scheduled workday(s)</small>
                            @if (!string.IsNullOrWhiteSpace(item.EmployeeNote)) { <p>@item.EmployeeNote</p> }
                            <small>Submitted @item.RequestedUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small>
                        </div>
                    </div>
                    <div class="approval-review-controls">
                        <div class="form-field"><label for="@($"days-{item.Id}")">Leave days to deduct (check public holidays)</label><input type="number" id="@($"days-{item.Id}")" class="form-control" @bind="approvalDayCounts[item.Id]" min="0.25" max="366" step="0.25" /></div>
                        <label class="policy-attestation"><input type="checkbox" @bind="approvalConfirmations[item.Id]" /> I checked the dates, work schedule and applicable public holidays; this day count is correct.</label>
                    </div>
                    <div class="approval-actions">
                        <button class="button-primary" type="button" disabled="@isReviewing" @onclick="() => ReviewRequest(item.Id, true)">Approve</button>
                        <button class="button-secondary" type="button" disabled="@isReviewing" @onclick="() => ReviewRequest(item.Id, false)">Decline</button>
                    </div>
                </div>
            }
        </section>
    }
    <p class="form-footnote" style="margin-top:16px">Paid leave approvals require an employer-configured policy effective on the leave start date and sufficient ledger balance unless negative balances are explicitly allowed. Approval creates a usage entry and an audit event. Public-holiday calendars and shift-specific rules still require manual verification.</p>
</div>

@code {
    private string? userId;
    private bool isLoading = true;
    private bool isReviewing;
    private string? feedback;
    private string? feedbackDetail;
    private readonly List<Guid> ownedOrganizationIds = new();
    private readonly List<ApprovalItem> requests = new();
    private readonly Dictionary<Guid, decimal> approvalDayCounts = new();
    private readonly Dictionary<Guid, bool> approvalConfirmations = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId)) { isLoading = false; return; }
        await LoadRequests();
        isLoading = false;
    }

    private async Task LoadRequests()
    {
        requests.Clear();
        ownedOrganizationIds.Clear();
        approvalDayCounts.Clear();
        approvalConfirmations.Clear();
        await using var db = await DbFactory.CreateDbContextAsync();
        var ownedIds = await db.OrganizationMemberships
            .Where(x => x.UserId == userId && x.IsActive && x.Role == "Owner")
            .Select(x => x.OrganizationId).ToListAsync();
        ownedOrganizationIds.AddRange(ownedIds);
        if (ownedIds.Count == 0) return;

        var rows = await db.LeaveRequests
            .Include(x => x.EmploymentRecord).ThenInclude(x => x.Organization)
            .Where(x => ownedIds.Contains(x.EmploymentRecord.OrganizationId) && x.Status == "Pending")
            .OrderBy(x => x.StartDate).ThenBy(x => x.RequestedUtc)
            .Take(200).ToListAsync();
        foreach (var row in rows)
        {
            var view = new ApprovalItem(row.Id, row.EmploymentRecord.EmployeeName, row.EmploymentRecord.Organization.Name,
                row.LeaveType, row.StartDate, row.EndDate, row.ScheduledWorkdays ?? 0, row.EmployeeNote, row.RequestedUtc, row.RequestedByUserId);
            requests.Add(view);
            approvalDayCounts[view.Id] = view.ScheduledWorkdays;
            approvalConfirmations[view.Id] = false;
        }
    }

    private async Task ReviewRequest(Guid requestId, bool approve)
    {
        if (isReviewing || string.IsNullOrWhiteSpace(userId)) return;
        isReviewing = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await LeaveRequestService.DecideAsync(db, userId, requestId, approve,
                approvalDayCounts.GetValueOrDefault(requestId), approvalConfirmations.GetValueOrDefault(requestId), DateOnly.FromDateTime(DateTime.Today));
            feedback = result.Message;
            feedbackDetail = result.Succeeded ? "The decision has been saved." : "No decision was saved.";
            if (result.Succeeded) await LoadRequests();
        }
        catch (DbUpdateException)
        {
            feedback = "The request changed or the decision could not be saved.";
            feedbackDetail = "Refresh the list before trying again.";
        }
        finally { isReviewing = false; }
    }
    private sealed record ApprovalItem(Guid Id, string EmployeeName, string OrganizationName, string LeaveType,
        DateOnly StartDate, DateOnly EndDate, decimal ScheduledWorkdays, string? EmployeeNote, DateTime RequestedUtc, string RequestedByUserId);
}
