@page "/not-found"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>Page not found | Work-Wise</PageTitle>

<div class="page-wrap">
    <section class="panel" style="max-width:760px;margin:24px auto">
        <p class="eyebrow">WORK-WISE</p>
        <h1>We couldn't find that page</h1>
        <p class="page-intro">The address may be outdated, or the page may have moved. Your account and saved records have not been changed by opening this page.</p>
        <div class="notice-banner">
            <span class="notice-symbol">i</span>
            <div>
                <strong>Requested address</strong>
                <p style="overflow-wrap:anywhere">@Navigation.Uri</p>
            </div>
        </div>
        <div class="ww-hero-actions" style="margin-top:24px;flex-wrap:wrap">
            <a class="button-primary" href="/">Go to overview</a>
            <a class="button-secondary" href="/workspace">Employer workspace</a>
            <a class="button-secondary" href="/leave">Leave &amp; absences</a>
        </div>
    </section>
</div>
