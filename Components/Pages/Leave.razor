@page "/leave"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using LeaveWise.Data
@using LeaveWise.Domain
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<LeaveWise.Data.ApplicationDbContext> DbFactory
@inject ILogger<Leave> Logger

<PageTitle>Leave & absences | Work-Wise</PageTitle>

<div class="page-wrap">
    <div class="page-title-row">
        <div>
            <p class="eyebrow">YOUR TIME, MADE CLEAR</p>
            <h1>Leave & absences</h1>
            <p class="page-intro">Submit a request and keep a persistent record of its approval status.</p>
        </div>
        <span class="demo-badge">EARLY ACCESS</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(feedback))
    {
        <div class="notice-banner"><span class="notice-symbol">i</span><div><strong>@feedback</strong><p>@feedbackDetail</p></div></div>
    }

    @if (isLoading)
    {
        <section class="panel"><p>Loading your employment records…</p></section>
    }
    else if (employments.Count == 0)
    {
        <section class="panel empty-state">
            <span class="empty-icon">INFO</span>
            <strong>No linked employment record yet</strong>
            <p>Ask your employer to create an employment record and generate a one-time invitation code. Sign in with the email address your employer entered, then enter that code below. Codes expire after seven days and can only be used once.</p>
            <EditForm Model="inviteInput" OnValidSubmit="RedeemInvite" FormName="RedeemEmploymentInvite">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <div class="form-field">
                    <label for="employment-invite-code">Employer invitation code</label>
                    <InputText id="employment-invite-code" class="form-control" @bind-Value="inviteInput.Code" autocomplete="off" maxlength="64" placeholder="Paste your one-time code" />
                    <ValidationMessage For="@(() => inviteInput.Code)" />
                </div>
                <button type="submit" class="button-primary" disabled="@isRedeemingInvite">@(isRedeemingInvite ? "Linking…" : "Link employment record")</button>
            </EditForm>
            <p class="form-footnote">Leave balances remain unavailable until your contract and applicable policy have been reviewed. Keep your invitation code private.</p>
        </section>
    }
    else
    {
        <div class="notice-banner">
            <span class="notice-symbol">i</span>
            <div><strong>Transparent early-access workflow</strong><p>Requests are saved for employer review. Scheduled workdays exclude your configured non-working days, but public-holiday calendars and shift-specific rules are not configured yet. Entitlement depends on an employer-reviewed policy; submitting does not mean approval.</p></div>
        </div>
        <div class="content-two-col">
            <section class="panel">
                <div class="panel-heading"><div><p class="eyebrow">QUICK ACTION</p><h2>Request time off</h2></div><span class="panel-icon">INFO</span></div>
                <EditForm Model="request" OnValidSubmit="SubmitRequest">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />
                    <div class="form-field">
                        <label for="employment">Employment record</label>
                        <InputSelect id="employment" class="form-control" @bind-Value="request.EmploymentRecordId">
                            @foreach (var employment in employments)
                            {
                                <option value="@employment.Id">@employment.Organization.Name - @employment.EmployeeName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-field"><label for="leave-type">Leave type</label><InputSelect id="leave-type" class="form-control" @bind-Value="request.LeaveType"><option>Annual leave</option><option>Sick leave</option><option>Family responsibility leave</option><option>Compassionate leave</option><option>Maternity leave</option><option>Parental leave</option><option>Unpaid leave</option><option>Other</option></InputSelect></div>
                    <div class="form-row">
                        <div class="form-field"><label for="start-date">First day</label><InputDate id="start-date" class="form-control" @bind-Value="request.StartDate" /></div>
                        <div class="form-field"><label for="end-date">Last day</label><InputDate id="end-date" class="form-control" @bind-Value="request.EndDate" /></div>
                    </div>
                    <div class="form-field"><label for="note">Note (optional)</label><InputTextArea id="note" class="form-control" @bind-Value="request.Note" maxlength="1000" placeholder="Add a note for your manager" /></div>
                    <button type="submit" class="button-primary button-wide" disabled="@isSaving">@(isSaving ? "Saving…" : "Submit leave request") <span>→</span></button>
                    <p class="form-footnote">Submitting records a pending request; it does not mean the leave is approved.</p>
                </EditForm>
            </section>
            <section class="panel">
                <div class="panel-heading"><div><p class="eyebrow">RECENT ACTIVITY</p><h2>Request history</h2></div><span class="count-chip">@requests.Count</span></div>
                @if (requests.Count == 0)
                {
                    <div class="empty-state"><span class="empty-icon">INFO</span><strong>No requests yet</strong><p>Your saved requests will appear here.</p></div>
                }
                else
                {
                    <div class="request-list">
                        @foreach (var item in requests)
                        {
                            <div class="request-item">
                                <span class="request-date">@item.StartDate.ToString("dd")<small>@item.StartDate.ToString("MMM")</small></span>
                                <div class="request-detail"><strong>@item.LeaveType</strong><small>@item.StartDate.ToString("dd MMM") - @item.EndDate.ToString("dd MMM yyyy")</small><small>@item.OrganizationName</small>
                                    @if (!string.IsNullOrWhiteSpace(item.EmployeeNote))
                                    {
                                        <small>@item.EmployeeNote</small>
                                    }
                                </div>
                                <span class="status-label @(item.Status == "Approved" ? "status-approved" : item.Status == "Rejected" ? "status-rejected" : "status-pending")">@item.Status</span>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    private string? userId;
    private bool isLoading = true;
    private bool isSaving;
    private bool isRedeemingInvite;
    private readonly InviteInput inviteInput = new();
    private string? feedback;
    private string? feedbackDetail;
    private readonly List<EmploymentOption> employments = new();
    private readonly List<RequestView> requests = new();
    private LeaveRequestInput request = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId))
        {
            isLoading = false;
            feedback = "Please sign in to request leave.";
            return;
        }

        await LoadData();
        isLoading = false;
    }

    private async Task LoadData()
    {
        employments.Clear();
        requests.Clear();
        await using var db = await DbFactory.CreateDbContextAsync();

        // Email-based linking is permitted only when Identity has independently confirmed the address.
        var account = await db.Users.AsNoTracking()
            .Where(x => x.Id == userId)
            .Select(x => new { x.Email, x.EmailConfirmed })
            .SingleOrDefaultAsync();
        if (account is { EmailConfirmed: true } && !string.IsNullOrWhiteSpace(account.Email))
        {
            var verifiedEmail = account.Email.Trim().ToUpperInvariant();
            var unlinked = await db.EmploymentRecords
                .Where(x => x.EmployeeUserId == null && x.Status == "Active" && x.EmployeeEmail.ToUpper() == verifiedEmail)
                .ToListAsync();
            foreach (var record in unlinked)
                record.EmployeeUserId = userId;
            if (unlinked.Count > 0)
                await db.SaveChangesAsync();
        }

        var rows = await db.EmploymentRecords
            .Include(x => x.Organization)
            .Where(x => x.EmployeeUserId == userId && x.Status == "Active")
            .OrderBy(x => x.Organization.Name)
            .ToListAsync();
        employments.AddRange(rows.Select(x => new EmploymentOption(x.Id, x.EmployeeName, x.Organization)));
        if (employments.Count > 0)
        {
            request.EmploymentRecordId = employments[0].Id;
            var ids = employments.Select(x => x.Id).ToArray();
            var saved = await db.LeaveRequests
                .Include(x => x.EmploymentRecord).ThenInclude(x => x.Organization)
                .Where(x => ids.Contains(x.EmploymentRecordId))
                .OrderByDescending(x => x.RequestedUtc)
                .Take(100)
                .ToListAsync();
            requests.AddRange(saved.Select(x => new RequestView(x.Id, x.LeaveType, x.StartDate, x.EndDate, x.EmployeeNote, x.Status, x.EmploymentRecord.Organization.Name)));
        }
    }

    private async Task RedeemInvite()
    {
        if (isRedeemingInvite || string.IsNullOrWhiteSpace(userId)) return;
        isRedeemingInvite = true;
        feedback = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await EmploymentInviteService.RedeemInviteAsync(db, userId, inviteInput.Code, DateTime.UtcNow);
            feedback = result.Succeeded ? "Employment record linked." : "Could not link the employment record.";
            feedbackDetail = result.Message;
            if (result.Succeeded)
            {
                inviteInput.Code = "";
                await LoadData();
            }
        }
        catch (DbUpdateException ex)
        {
            Logger.LogError(ex, "Database update failed while redeeming an employment invitation for user {UserId}", userId);
            feedback = "The invitation could not be redeemed.";
            feedbackDetail = "Refresh the page and check whether the employment record is already linked before trying again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while redeeming an employment invitation for user {UserId}", userId);
            feedback = "The invitation could not be redeemed.";
            feedbackDetail = "Please refresh the page and try again. The code has not been displayed in any error message.";
        }
        finally { isRedeemingInvite = false; }
    }

    private async Task SubmitRequest()
    {
        if (isSaving || string.IsNullOrWhiteSpace(userId)) return;
        feedback = null;
        if (request.EndDate < request.StartDate)
        {
            feedback = "The end date must be on or after the start date.";
            feedbackDetail = "Please correct the dates and try again.";
            return;
        }
        if (request.StartDate < DateOnly.FromDateTime(DateTime.Today))
        {
            feedback = "Choose today or a future date.";
            feedbackDetail = "Past-dated requests are not accepted in this early-access flow.";
            return;
        }
        if (request.EndDate.DayNumber - request.StartDate.DayNumber > 365)
        {
            feedback = "The selected date range is too long.";
            feedbackDetail = "A request can cover at most 366 calendar days. Split longer periods into separate requests.";
            return;
        }
        if (!new[] { "Annual leave", "Sick leave", "Family responsibility leave", "Compassionate leave", "Maternity leave", "Parental leave", "Unpaid leave", "Other" }.Contains(request.LeaveType, StringComparer.Ordinal))
        {
            feedback = "Choose a valid leave type.";
            feedbackDetail = "No request was saved.";
            return;
        }

        isSaving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var employment = await db.EmploymentRecords
                .Include(x => x.Organization)
                .SingleOrDefaultAsync(x => x.Id == request.EmploymentRecordId && x.EmployeeUserId == userId && x.Status == "Active");
            if (employment is null)
            {
                feedback = "Your employment record could not be verified.";
                feedbackDetail = "Refresh the page and select an active record linked to your account.";
                return;
            }

            var scheduledDays = new HashSet<DayOfWeek>();
            for (var day = 0; day < 7; day++)
                if ((employment.ScheduledWorkdaysMask & (1 << day)) != 0)
                    scheduledDays.Add((DayOfWeek)(((day + 1) % 7)));
            if (scheduledDays.Count == 0)
            {
                feedback = "Your work schedule needs review.";
                feedbackDetail = "Ask your employer to configure scheduled workdays before submitting leave.";
                return;
            }

            var workdays = LeaveWise.Domain.LeaveCalculator.CountScheduledWorkdays(request.StartDate, request.EndDate, scheduledDays);
            if (workdays == 0)
            {
                feedback = "The selected dates contain no scheduled workdays.";
                feedbackDetail = "Choose dates that include at least one scheduled workday.";
                return;
            }

            var record = new LeaveWise.Data.LeaveRequestRecord
            {
                EmploymentRecordId = employment.Id,
                LeaveType = request.LeaveType,
                StartDate = request.StartDate,
                EndDate = request.EndDate,
                ScheduledWorkdays = workdays,
                EmployeeNote = string.IsNullOrWhiteSpace(request.Note) ? null : request.Note.Trim(),
                Status = "Pending",
                RequestedByUserId = userId
            };
            db.LeaveRequests.Add(record);
            await db.AuditEvents.AddAsync(new LeaveWise.Data.AuditEvent
            {
                OrganizationId = employment.OrganizationId,
                ActorUserId = userId,
                Action = "LeaveRequestSubmitted",
                EntityType = "LeaveRequest",
                EntityId = record.Id.ToString(),
                DetailsJson = System.Text.Json.JsonSerializer.Serialize(new { record.LeaveType, record.StartDate, record.EndDate, ScheduledWorkdays = workdays })
            });
            await db.SaveChangesAsync();
            requests.Insert(0, new RequestView(record.Id, record.LeaveType, record.StartDate, record.EndDate, record.EmployeeNote, record.Status, employment.Organization.Name));
            feedback = "Leave request saved.";
            feedbackDetail = $"It is pending employer review. {workdays} scheduled workday(s) were counted excluding configured non-working weekdays. Public holidays are not automatically excluded and must be checked by the approver.";
            request = new LeaveRequestInput { EmploymentRecordId = employment.Id, StartDate = DateOnly.FromDateTime(DateTime.Today.AddDays(7)), EndDate = DateOnly.FromDateTime(DateTime.Today.AddDays(7)) };
        }
        catch (DbUpdateException)
        {
            feedback = "The request could not be saved.";
            feedbackDetail = "Please try again. No leave balance was changed.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class InviteInput
    {
        [Required, StringLength(64, MinimumLength = 20)] public string Code { get; set; } = "";
    }
    private sealed record EmploymentOption(Guid Id, string EmployeeName, LeaveWise.Data.Organization Organization);
    private sealed record RequestView(Guid Id, string LeaveType, DateOnly StartDate, DateOnly EndDate, string? EmployeeNote, string Status, string OrganizationName);
    private sealed class LeaveRequestInput
    {
        [Required] public Guid EmploymentRecordId { get; set; }
        [Required] public string LeaveType { get; set; } = "Annual leave";
        public DateOnly StartDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(7));
        public DateOnly EndDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(7));
        [StringLength(1000)] public string? Note { get; set; }
    }
}
