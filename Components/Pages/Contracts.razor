@page "/contracts"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
<PageTitle>My contract | Work-Wise</PageTitle>
<div class="page-wrap"><div class="page-title-row"><div><p class="eyebrow">KNOW WHAT YOU SIGNED</p><h1>My contract</h1><p class="page-intro">Turn the important parts of an employment contract into information you can review and understand.</p></div><span class="demo-badge">EARLY PREVIEW</span></div><div class="notice-banner"><span class="notice-symbol">i</span><div><strong>Secure processing is not connected yet</strong><p>This prototype does not upload or retain your file. Do not select a sensitive real contract in this demo.</p></div></div>
<div class="contract-layout"><section class="panel upload-panel"><div class="upload-illustration"><span>▤</span><i>+</i></div><h2>Start with your contract</h2><p>In the full product, Work-Wise will extract clauses from a PDF or a clear photo, show where each detail came from, and ask you to confirm it.</p><label class="upload-drop"><InputFile OnChange="OnFileSelected" accept=".pdf,.png,.jpg,.jpeg" /><span class="upload-file-icon">UP</span><strong>Choose a file</strong><small>PDF or image · demo selection only</small></label>@if (!string.IsNullOrWhiteSpace(selectedFile)) { <div class="inline-feedback">Selected: @selectedFile. Nothing has been uploaded.</div> }<ul class="check-list"><li>✓ Leave entitlement clauses</li><li>✓ Salary and pay frequency</li><li>✓ Bonus conditions and dates</li><li>✓ Source-page references for review</li></ul></section>
<section class="panel"><div class="panel-heading"><div><p class="eyebrow">EXTRACTION PREVIEW</p><h2>What you'll review</h2></div><span class="panel-icon">INFO</span></div><div class="extraction-row"><span class="extraction-symbol">INFO</span><div><strong>Country & work schedule</strong><p>Jurisdiction, normal working days and hours</p></div><span class="extraction-status">To confirm</span></div><div class="extraction-row"><span class="extraction-symbol">INFO</span><div><strong>Leave terms</strong><p>Annual, sick and other contractual leave</p></div><span class="extraction-status">To confirm</span></div><div class="extraction-row"><span class="extraction-symbol">INFO</span><div><strong>Pay & benefits</strong><p>Salary basis, bonus wording and eligibility</p></div><span class="extraction-status">To confirm</span></div><div class="contract-warning"><strong>Important</strong><p>AI extraction is a draft, not a legal determination. Statutory rules and contract clauses must be checked before an entitlement is activated.</p></div></section></div></div>
@code { private string? selectedFile; private void OnFileSelected(InputFileChangeEventArgs e) { selectedFile = e.File.Name; } }
